# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL in production/Docker; SQLite for zero-config local dev/tests)
DATABASE_URL=sqlite+aiosqlite:///./data/mandate.db
# DATABASE_URL=postgresql+asyncpg://mandate:mandate@localhost:5432/mandate

# Auth / Admin
API_ADMIN_TOKEN=dev-admin-token-change-me
API_USER_TOKEN=dev-user-token-change-me

# PayPal Sandbox / Live
# PAYPAL_MODE: mock | sandbox | live
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_SELLER_A_ID=SELLER-A-VERIFIED
PAYPAL_SANDBOX_SELLER_B_ID=SELLER-B-ATTACKER

# LLM Providers (optional; deterministic fallback works without keys)
# LLM_PROVIDER: gemini | groq | deterministic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Channel3 Catalog (optional; MockCatalog works out of the box)
# CATALOG_PROVIDER: mock | channel3
CATALOG_PROVIDER=mock
CHANNEL3_API_KEY=

# Notifier (console | webhook)
NOTIFIER_PROVIDER=console
ZAPIER_WEBHOOK_URL=

# Background Recheck Worker
RECHECK_POLL_INTERVAL_SECONDS=30
ENABLE_DEMO_LAB=true
