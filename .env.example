# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL in production/Docker; SQLite for zero-config local dev/tests)
DATABASE_URL=sqlite+aiosqlite:///./data/mandate.db
# DATABASE_URL=postgresql+asyncpg://mandate:mandate@localhost:5432/mandate

# Auth / Admin (set REQUIRE_AUTH=true to enforce Bearer / x-api-key headers)
REQUIRE_AUTH=false
API_ADMIN_TOKEN=dev-admin-token-change-me
API_USER_TOKEN=dev-user-token-change-me

# PayPal Sandbox / Live
# PAYPAL_MODE: mock | sandbox | live
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_SELLER_A_ID=SELLER-A-VERIFIED
PAYPAL_SANDBOX_SELLER_B_ID=SELLER-B-ATTACKER

# LLM Providers (optional; deterministic fallback works without keys)
# LLM_PROVIDER: gemini | groq | astropods | deterministic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Astropods AI Gateway (optional OpenAI-compatible gateway + OTEL tracing)
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
ASTRO_MODEL=gemini-3.6-flash

# Channel3 Catalog (optional; MockCatalog works out of the box)
# CATALOG_PROVIDER: mock | channel3
CATALOG_PROVIDER=mock
CHANNEL3_API_KEY=

# Kernel Cloud Browser Verification (optional; deterministic fallback works without keys)
KERNEL_API_KEY=
KERNEL_BASE_URL=https://api.onkernel.com

# Elastic Hybrid / Vector Search (optional; in-memory scored search works without keys)
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=mandate

# Render Workflows Orchestration (optional; simulated workflow run works without keys)
RENDER_API_KEY=
RENDER_API_BASE=https://api.render.com/v1
RENDER_WORKFLOW_TASK_SLUG=

# Notifier (console | webhook)
NOTIFIER_PROVIDER=console
ZAPIER_WEBHOOK_URL=

# Background Recheck Worker
RECHECK_POLL_INTERVAL_SECONDS=30
ENABLE_DEMO_LAB=true
