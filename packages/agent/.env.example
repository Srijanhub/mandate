# Copy this file to packages/agent/.env (never commit .env!)
# Standardized across Mandate on gemini-3.8-flash (mock is only for offline tests)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Add your Google Gemini API key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Safety controls
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
